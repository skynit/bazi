    "inclusion": [
      "能够理解同意书并自主同意",
      "能够提供出生时间精度而非被迫给出伪精确时间",
      "能够按审批后的固定计划完成结构化随访"
    ],
    "exclusion": [
      "未成年人",
      "无法自主同意",
      "当前心理危机或对命理有强依赖风险",
      "研究参与可能影响医疗、法律、财务、婚姻或其他重大决定",
      "研究团队成员或直接参与系统开发、评分与裁决者"
    ],
    "recruitment_channels": [],
