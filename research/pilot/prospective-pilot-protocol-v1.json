      "public_request_fields_removed": true,
      "runtime_persistence_assignments_removed": true,
      "required_actions": [
        "确认历史部署是否实际存有非零事件字段",
        "记录来源、同意状态、数量、时间范围和访问记录",
        "由隐私审查决定删除、隔离或合法保留",
        "验证备份和派生数据的删除或隔离",
        "禁止把旧段落反馈自动并入 Pilot"
      ]
    }
  },
  "safety": {
