{
  "schema": "prospective_fortune_pilot_protocol_v1",
  "protocol_id": "fortune-prospective-pilot-v1",
  "version": "2026-07-17.1",
  "title": "八字与紫微斗数前瞻性预测研究 Pilot 草案",
  "language": "zh-CN",
  "status": "draft_not_approved",
  "purpose": "在不预设预测有效的前提下，验证预注册、随访、盲评、对照、评分和数据保护流程是否可行。",
  "runtime_boundary": {
    "research_only": true,
    "recruitment_enabled": false,
    "event_collection_enabled": false,
    "pilot_api_enabled": false,
    "pilot_database_enabled": false,
    "participant_predictions_visible_during_followup": false,
    "claim_boundary": "流程 Pilot 不证明传统正确性或预测有效性"
  },
  "research_questions": [
    "冻结后的八字声明是否比随机、通用话术和打乱出生信息基线更具体且更能区分后续低风险事件？",
    "冻结后的紫微声明是否比相同基线更具体且更能区分后续低风险事件？",
    "八字与紫微组合是否在预注册主要指标上稳定优于两个单系统，而不是只在事后选择的指标上更好？",
    "输入时间精度、Profile 和参与者分层是否造成可重复的性能差异？"
  ],
  "objectives": {
    "primary": "验证研究流程能否生成可证伪声明、按期取得低风险结构化事件、完成盲评并重算预注册指标",
    "secondary": [
      "估计弃权率、失访率、事件基础率和评分者一致度",
      "发现巴纳姆话术、时间窗漂移、信息泄漏和敏感风险",
      "为正式研究的 power analysis 提供流程参数，而不是用 Pilot 宣称效力"
    ],
    "not_objectives": [
      "证明命理必然有效",
      "优化到 Pilot 参与者的结果",
      "给参与者提供医疗、法律、财务、职业或关系决策建议",
      "把用户点赞、历史回忆或第三方算法一致性解释为预测准确率"
    ]
  },
  "study_design": {
    "design": "prospective_preregistered_controlled_blinded_process_pilot",
    "proposed_pilot_sample_size": 200,
    "sample_size_status": "proposal_not_power_approved",
    "formal_sample_size_policy": "由 Pilot 流失率、基础率、方差和预先选定效应量完成 power analysis 后确定",
    "followup_duration": null,
    "followup_schedule": [],
    "followup_status": "not_approved",
    "prediction_freeze": "所有声明、时间窗、证据、Profile、引擎、规则版本和弃权必须在结果窗口开始前冻结并生成摘要",
    "participant_exposure": "随访期间不向参与者展示封存的个体事件声明，以降低自我实现和行为干预",
    "arms": [
      {"id": "bazi_actual", "kind": "system", "birth_input": "actual", "status": "not_eligible_until_profile_and_scoring_approval"},
      {"id": "ziwei_actual", "kind": "system", "birth_input": "actual", "status": "not_eligible_until_profile_and_scoring_approval"},
      {"id": "bazi_ziwei_combined", "kind": "system", "birth_input": "actual", "status": "not_eligible_until_combination_rule_is_preregistered"},
      {"id": "base_rate_random", "kind": "control", "birth_input": "none", "status": "not_approved"},
      {"id": "generic_statement", "kind": "control", "birth_input": "none", "status": "not_approved"},
      {"id": "shuffled_birth_input", "kind": "control", "birth_input": "participant_permuted", "status": "not_approved"},
      {"id": "expert_baseline", "kind": "control", "birth_input": "actual", "status": "not_approved"}
    ],
    "randomization": {
      "enabled": false,
      "unit": "participant",
      "seed_commitment_required": true,
      "allocation_concealment_required": true,
      "status": "method_not_approved"
    },
    "blinding": {
      "participant_blinded_to_sealed_claims": true,
      "outcome_reviewers_blinded_to_system_profile_and_arm": true,
      "analyst_blinded_until_primary_table_frozen": true,
      "independent_reviewers": 2,
      "third_reviewer_for_disagreement": true
    }
  },
  "profile_gate": {
    "eligible_profiles": [],
    "candidates": [
      {"profile_id": "ziping-fuyi-v2", "status": "not_eligible_draft_not_runtime_selectable"},
      {"profile_id": "ziwei-sanhe-v1", "status": "not_eligible_draft_not_runtime_selectable"},
      {"profile_id": "ziwei-nihaixia-v1", "status": "not_eligible_missing_source_and_gold"}
    ],
    "requirements": [
      "Profile 必须可运行时选择且失败关闭",
      "排盘 P0 Gold 门禁通过",
      "声明规则、版本和引用冻结",
      "同一参与者不得在研究中切换 Profile",
      "八字、紫微和组合结果必须分别报告，不能只报告最好者"
    ]
  },
  "event_scope": {
    "status": "taxonomy_not_approved",
    "proposed_low_risk_categories": [
      "employment_role_or_status_change",
      "city_level_relocation",
      "education_or_training_milestone",
      "predeclared_project_milestone"
    ],
    "prohibited_categories": [
      "death_or_lifespan",
      "medical_or_mental_health_diagnosis",
      "self_harm_or_violence",
      "crime_or_legal_outcome",
      "investment_return_or_financial_instruction",
      "pregnancy_or_fertility",
      "sexual_activity",
      "marriage_or_divorce_decision",
      "minor_child_outcome"
    ],
    "minimum_time_granularity": "month",
    "free_text_enabled": false,
    "exact_amount_enabled": false,
    "exact_address_enabled": false,
    "retrospective_event_entry_enabled": false,
    "ambiguity_policy": "未在事件字典中预定义且不能由盲审 exact/rubric 判定的事件记为不可评分，不得事后扩展定义"
  },
  "prediction_contract": {
    "status": "not_approved",
    "required_fields": ["claim_id", "event_category", "time_window", "profile_id", "engine_version", "rule_version", "evidence", "abstain"],
    "probability_output_enabled": false,
    "probability_status": "no_calibrated_event_probability_model",
    "abstention_required": true,
    "barnum_statement_policy": "无法对应单一事件字典项和固定时间窗的通用话术不得计为命中",
    "time_window_policy": "结果揭盲后不得扩大、平移、合并或拆分时间窗"
  },
  "pre_registration": {
    "registry": "not_selected",
    "registration_id": "",
    "status": "not_registered",
    "must_freeze": [
