      "对照组、随机种子承诺和盲法",
      "主要指标、次要指标和多重比较方案",
      "缺失、失访、部分命中和不可评分规则",
      "分层、公平性、停止规则和负面结果报告方案",
      "分析代码与数据冻结摘要"
    ],
    "post_registration_changes": "只能形成带时间戳的修订版；不得覆盖原注册，主要分析必须同时按原方案报告"
  },
  "scoring_plan": {
    "status": "not_approved",
    "primary_endpoint": "not_selected",
    "candidate_classification_metrics": ["precision", "recall", "F1", "PR_AUC"],
    "candidate_probability_metrics": ["Brier_score", "log_loss", "expected_calibration_error"],
    "probability_metric_gate": "只有独立批准且冻结的概率模型才能计算；当前禁用",
    "candidate_time_metrics": ["time_window_IoU", "absolute_month_error", "lead_time"],
    "specificity_metrics": ["barnum_statement_rate", "falsifiable_claim_rate", "abstention_rate"],
    "process_metrics": ["recruitment_rate", "retention_rate", "missingness", "reviewer_agreement", "adjudication_rate"],
    "fairness_strata": ["gender", "age_band", "region", "birth_time_precision", "profile"],
    "partial_match_rule": "not_selected",
    "missing_data_rule": "not_selected",
    "multiple_comparison_rule": "not_selected",
    "single_accuracy_percentage_allowed": false,
    "pilot_effect_claim_allowed": false
  },
  "participants": {
