    "privacy_contact": "not_designated",
    "storage_region": "not_selected",
    "retention_days": null,
    "retention_status": "not_approved",
    "encryption": {"in_transit": "required_not_verified", "at_rest": "required_not_verified"},
    "separation": ["identity_or_contact", "birth_input", "event_labels", "analysis_dataset"],
    "prohibited_identifiers": ["name", "government_id", "exact_address", "contacts", "chat_history"],
    "research_id": "cryptographically_random_nonsemantic_id_required",
    "access_control": "least_privilege_with_logged_access_and_periodic_review",
    "export_correction_deletion": "required_but_workflow_not_approved",
    "training_use": "separate_opt_in_required_default_false",
    "secondary_research_use": "separate_opt_in_required_default_false",
    "public_reporting": "aggregated_only_after_minimum_cell_size_and_reidentification_review",
    "legacy_feedback_audit": {
