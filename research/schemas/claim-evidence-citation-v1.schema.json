{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bazi:schema:claim-evidence-citation:v1",
  "title": "Claim/Evidence/Citation Envelope v1",
  "description": "命理输出的可审计声明合同。confidence 表示标签稳定性和证据质量，不表示现实事件发生概率。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "system",
    "profile_id",
    "engine_version",
    "rule_version",
    "input_fingerprint",
    "claim_text",
    "claim_type",
    "claim_status",
    "confidence",
    "evidence",
    "counter_evidence",
    "citations",
    "sensitive_domains",
    "provenance",
    "review",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "claim_evidence_citation_v1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"
    },
    "system": {
      "enum": ["bazi", "ziwei"]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "claim_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "claim_type": {
      "enum": [
        "chart_fact",
        "structural_rule",
        "school_dependent_interpretation",
        "advisory",
        "outcome_claim"
      ]
    },
    "claim_status": {
      "enum": [
        "observed",
        "candidate",
        "school_dependent",
        "disputed",
        "insufficient_evidence",
        "rejected"
      ]
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "counter_evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "sensitive_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "personality",
          "relationship",
          "health",
          "lifespan",
          "finance",
          "career",
          "legal",
          "violence_or_self_harm",
          "minor_or_parenting",
          "housing_or_property",
          "none"
        ]
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "enum": ["chart_fact", "structural_rule"]
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_status": {
            "const": "insufficient_evidence"
          }
        },
        "required": ["claim_status"]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "meaning": {
                "const": "not_scored"
              },
              "value": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "outcome_claim"
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          },
          "review": {
            "properties": {
              "status": {
                "const": "adjudicated"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning", "value", "event_probability", "components"],
      "properties": {
        "meaning": {
          "enum": ["label_stability_and_evidence_quality", "not_scored"]
        },
        "value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "event_probability": {
          "const": false
        },
        "components": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/confidence_component"
          }
        }
      }
    },
    "confidence_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "basis"],
      "properties": {
        "name": {
          "enum": ["input_stability", "rule_validation", "expert_agreement", "citation_support"]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "ref_id",
        "value",
        "support_direction",
        "source_tier",
        "validation_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{3,127}$"
        },
        "kind": {
          "enum": ["input_fact", "chart_fact", "rule_finding", "source_quote", "counterexample", "uncertainty"]
        },
        "ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {},
        "effect": {
          "type": ["number", "null"],
          "minimum": -1,
          "maximum": 1
        },
        "support_direction": {
          "enum": ["supports", "opposes", "limits", "context_only"]
        },
        "source_tier": {
          "enum": ["gold", "silver", "bronze", "classical_text_local", "runtime_observation", "user_input"]
        },
        "validation_status": {
          "enum": ["validated", "not_validated", "disputed", "not_available"]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "evidence_ids",
        "source_kind",
        "title",
        "author",
        "edition",
        "volume",
        "chapter",
        "page",
        "locator",
        "artifact_path",
        "artifact_sha256",
        "quote",
        "quote_sha256",
        "language",
        "source_tier",
        "verification_status"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{3,127}$"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_kind": {
          "enum": ["primary_text", "commentary", "expert_annotation", "software_source", "dataset"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        },
        "chapter": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "quote_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language": {
          "enum": ["zh-Hans", "zh-Hant", "en", "other"]
        },
        "source_tier": {
          "enum": ["gold", "silver", "bronze", "classical_text_local", "runtime_source"]
        },
        "verification_status": {
          "enum": ["located", "ocr_unverified", "expert_verified", "disputed"]
        }
      },
      "anyOf": [
        {
          "properties": {
            "page": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "locator": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "model", "prompt_version", "retrieval_index_version", "source_output_path", "source_output_sha256", "created_at"],
      "properties": {
        "generator": {
          "enum": ["deterministic_runtime", "llm", "human", "migration"]
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "retrieval_index_version": {
          "type": "string"
        },
        "source_output_path": {
          "type": "string",
          "minLength": 1
        },
        "source_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviews", "adjudication", "gold_eligible"],
      "properties": {
        "status": {
          "enum": ["unreviewed", "in_review", "adjudicated", "rejected"]
        },
        "reviews": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/reviewer_decision"
          }
        },
        "adjudication": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/adjudication"
            }
          ]
        },
        "gold_eligible": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "adjudicated"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reviews": {
                "minItems": 2
              },
              "adjudication": {
                "$ref": "#/$defs/adjudication"
              }
            }
          },
          "else": {
            "properties": {
              "gold_eligible": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "reviewer_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "blinded_to_other_reviews", "decision", "sensitive_flags", "notes", "reviewed_at"],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "blinded_to_other_reviews": {
          "const": true
        },
        "decision": {
          "enum": ["supported", "refuted", "no_evidence", "over_inference", "sensitive_risk"]
        },
        "sensitive_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicator_id", "decision", "reason", "adjudicated_at"],
      "properties": {
        "adjudicator_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["supported", "refuted", "no_evidence", "over_inference", "sensitive_risk"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "adjudicated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
