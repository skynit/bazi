# Backend
SERVER_PORT=8088
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*

# Database
# Leave DB_HOST empty for local SQLite mode.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASS=root123
DB_NAME=bazi
SQLITE_PATH=./data/bazi.db

# Docker Compose host ports
BACKEND_PORT=8080
FRONTEND_PORT=80
DB_EXTERNAL_PORT=3306

# Frontend dev proxy
VITE_API_TARGET=http://localhost:8088
VITE_DEV_PORT=5174

# Five-element visual asset library
ELEMENT_ASSET_DIR=./data/element-assets
ADMIN_USERNAME=admin

# Classical BaZi interpretation RAG
# Lightweight local mode: build once with scripts/build-local-bazi-rag-index.sh,
# then set RAG_ENABLED=true and keep RAG_PROVIDER=sqlite_fts5.
RAG_ENABLED=false
RAG_PROVIDER=sqlite_fts5
RAG_TIMEOUT_SECONDS=8
RAG_MIN_SCORE=0.35
RAG_TOP_K=8
LOCAL_RAG_SOURCE_DIR=/home/skynit/mingli_db/md/bazi
LOCAL_RAG_INDEX_PATH=../data/bazi_fts.db

# Optional external RAGFlow provider. Use only with RAG_PROVIDER=ragflow.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_BAZI_DATASET_ID=
